APP_NAME="Agency Web Development System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agencyos
DB_USERNAME=root
DB_PASSWORD=
# Database cloud (mis. TiDB Cloud) wajib SSL. Di Docker/Render isi: /etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=15

# Session timeout untuk token admin (menit). null = tidak pernah expired.
SANCTUM_TOKEN_EXPIRATION=480

FILESYSTEM_DISK=public

AGENCY_NAME="B!ng0.dev"
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Akun admin pertama (dipakai saat db:seed). OTP login dikirim ke ADMIN_EMAIL.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email OTP via Resend (HTTP API; SMTP diblokir di Render free).
# Lokal tanpa Resend: ganti MAIL_MAILER=log lalu lihat OTP di storage/logs/laravel.log
MAIL_MAILER=resend
RESEND_API_KEY=
# Tes: onboarding@resend.dev (hanya bisa kirim ke email pemilik akun Resend).
# Live: alamat dari domain milikmu yang sudah diverifikasi di Resend, mis. noreply@domainmu.com
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="B!ng0.dev"

# /api/login melewati OTP -> biarkan false kecuali memang dibutuhkan.
API_LOGIN_ENABLED=false
