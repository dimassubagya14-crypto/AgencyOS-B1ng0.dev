APP_NAME="Agency Web Development System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agencyos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Session timeout untuk token admin (menit). null = tidak pernah expired.
# PRD bab 6 mewajibkan session timeout — set angka wajar, mis. 480 (8 jam).
SANCTUM_TOKEN_EXPIRATION=480

FILESYSTEM_DISK=public

# Digunakan untuk generate proposal/message (bab 7 PRD) — nama agency dipakai
# untuk placeholder {nama_agency} di template.
AGENCY_NAME="B!ng0.dev"
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Email pembagian tugas (set ke smtp agar email benar-benar terkirim; log untuk testing lokal)
# MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_ENCRYPTION=null
# MAIL_FROM_ADDRESS="hello@bing0.dev"
# MAIL_FROM_NAME="B!ng0.dev"
